# Install: cp tools/pqrascv-keyd.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now pqrascv-keyd

[Unit]
Description=pqrascv ML-DSA Key Management Daemon
After=network.target
Documentation=https://github.com/comwanga/pqrascv-core

[Service]
Type=simple
ExecStart=/usr/local/bin/pqrascv-keyd
Environment="KEYD_SOCKET=/run/pqrascv/keyd.sock"
Environment="KEYD_KEYDIR=/var/lib/pqrascv/keys"
RuntimeDirectory=pqrascv
RuntimeDirectoryMode=0750
StateDirectory=pqrascv/keys
StateDirectoryMode=0700
User=pqrascv
Group=pqrascv
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pqrascv /run/pqrascv
ProtectHome=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
